# Fixes a real, reproduced bug (2026-09-03): this cloud sandbox occasionally
# drops a network connection silently — no error, no "connection closed" — and
# npm's default fetch timeout is long enough that a dropped connection during
# `npm install` can hang for several minutes with zero output, easily mistaken
# for a genuine stall (it was, until root-caused via a side-by-side curl test
# that confirmed the network itself was fine). This makes npm give up on a
# silent connection after 20s and retry with a fresh one, rather than waiting
# indefinitely on a connection that will never respond.
fetch-timeout=20000
fetch-retries=3
